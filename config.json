{
  "name": "Smart Calendar Scheduler",
  "version": "1.0.4",
  "slug": "smart_calendar_scheduler",
  "description": "AI Scheduling Engine for personal task planning. Called by n8n workflows via HTTP POST.",
  "url": "https://github.com/taothienpeter/ha-scheduler-addon",
  "arch": [
    "aarch64",
    "amd64",
    "armv7"
  ],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "5000/tcp": 5000
  },
  "ports_description": {
    "5000/tcp": "FastAPI Scheduler API (for n8n HTTP node)"
  },
  "map": [
    "homeassistant_config:rw"
  ],
  "options": {
    "log_level": "info"
  },
  "schema": {
    "log_level": "list(info|debug|warning|error)?"
  },
  "watchdog": "http://[HOST]:[PORT:5000]/health"
}
